rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isHexColor(val) {
      return val is string && val.size() >= 4 && val.size() <= 9 && val.matches('^#[0-9a-fA-F]{3,8}$');
    }

    function isValidTradeHubId(hubId) {
      return hubId is string && hubId in [
        'yagcilarici',
        'nasuhpasa',
        'trengari',
        'forumaydin',
        'ramazanpasa',
        'tralleis'
      ];
    }

    function isValidTradeItemId(itemId) {
      return itemId is string && itemId in [
        'aydin_inciri',
        'zeytinyagi',
        'kestane_sekeri',
        'pamuk_balyasi',
        'karacasu_seramik',
        'yagcilar_baharat',
        'ege_lavanta',
        'plaj_hasir',
        'deniz_tuzu',
        'mermer_replik',
        'antik_sikke_katalog',
        'sultaniye_pekmez'
      ];
    }

    function isValidTradeInventorySlot(slot) {
      return slot is map &&
        slot.keys().hasAll(['itemId', 'quantity', 'avgUnitCost']) &&
        slot.keys().hasOnly(['itemId', 'quantity', 'avgUnitCost']) &&
        isValidTradeItemId(slot.itemId) &&
        slot.quantity is int && slot.quantity >= 1 && slot.quantity <= 999 &&
        slot.avgUnitCost is int && slot.avgUnitCost >= 1 && slot.avgUnitCost <= 5000;
    }

    function isValidTradeProfile(tp) {
      return tp is map &&
        tp.keys().hasAll([
          'version',
          'cargoTier',
          'reputationXp',
          'totalTrades',
          'totalProfit',
          'starterGrantClaimed',
          'inventory',
          'completedContractKeys',
          'recentCommandIds'
        ]) &&
        tp.keys().hasOnly([
          'version',
          'cargoTier',
          'reputationXp',
          'totalTrades',
          'totalProfit',
          'starterGrantClaimed',
          'inventory',
          'completedContractKeys',
          'recentCommandIds'
        ]) &&
        tp.version is int && tp.version >= 1 && tp.version <= 10000000 &&
        tp.cargoTier is int && tp.cargoTier >= 1 && tp.cargoTier <= 5 &&
        tp.reputationXp is int && tp.reputationXp >= 0 && tp.reputationXp <= 1000000 &&
        tp.totalTrades is int && tp.totalTrades >= 0 && tp.totalTrades <= 1000000 &&
        tp.totalProfit is int && tp.totalProfit >= -1000000 && tp.totalProfit <= 10000000 &&
        tp.starterGrantClaimed is bool &&
        tp.inventory is list && tp.inventory.size() <= 24 &&
        (tp.inventory.size() == 0 || isValidTradeInventorySlot(tp.inventory[0])) &&
        tp.completedContractKeys is list && tp.completedContractKeys.size() <= 40 &&
        (tp.completedContractKeys.size() == 0 || (tp.completedContractKeys[0] is string && tp.completedContractKeys[0].size() >= 1 && tp.completedContractKeys[0].size() <= 48)) &&
        tp.recentCommandIds is list && tp.recentCommandIds.size() <= 32 &&
        (tp.recentCommandIds.size() == 0 || (tp.recentCommandIds[0] is string && tp.recentCommandIds[0].size() >= 1 && tp.recentCommandIds[0].size() <= 48));
    }

    function isValidVehicleConfig(vc) {
      return vc is map &&
        vc.keys().hasOnly(['type', 'color', 'finish', 'accentColor', 'hasAccessory', 'hasStripe']) &&
        vc.type in ['car', 'bicycle', 'motorcycle'] &&
        isHexColor(vc.color) &&
        vc.finish in ['gloss', 'matte'] &&
        isHexColor(vc.accentColor) &&
        vc.hasAccessory is bool &&
        vc.hasStripe is bool;
    }

    function isValidHouseExterior(he) {
      return he is map &&
        he.keys().hasOnly(['style', 'wallColor', 'roofColor', 'trimColor']) &&
        he.style in ['cottage_villa', 'modern_gable', 'aegean_veranda', 'twin_cottage'] &&
        isHexColor(he.wallColor) &&
        isHexColor(he.roofColor) &&
        isHexColor(he.trimColor);
    }

    function isValidAvatarConfig(ac) {
      return ac is map &&
        ac.keys().hasOnly(['skinColor', 'shirtColor', 'pantsColor', 'hairStyle', 'hairColor']) &&
        isHexColor(ac.skinColor) &&
        isHexColor(ac.shirtColor) &&
        isHexColor(ac.pantsColor) &&
        ac.hairStyle in ['kasket', 'short', 'long', 'bun'] &&
        isHexColor(ac.hairColor);
    }

    function isValidFurnitureItem(fi) {
      return fi is map &&
        fi.keys().hasOnly(['id', 'enabled', 'slotIndex', 'x', 'z', 'rotY', 'styleId']) &&
        fi.id is string && fi.id.size() >= 1 && fi.id.size() <= 24 &&
        fi.enabled is bool &&
        fi.slotIndex is int && fi.slotIndex >= 0 && fi.slotIndex <= 10 &&
        (!('x' in fi) || fi.x is number) &&
        (!('z' in fi) || fi.z is number) &&
        (!('rotY' in fi) || fi.rotY is number) &&
        (!('styleId' in fi) || (fi.styleId is string && fi.styleId.size() >= 1 && fi.styleId.size() <= 40));
    }

    function isValidCozyRoomState(cr) {
      return cr is map &&
        cr.keys().hasOnly(['wallColor', 'floorTone', 'lampOn', 'petType', 'petAffection', 'avatarPlaced', 'avatarConfig', 'furniture']) &&
        isHexColor(cr.wallColor) &&
        cr.floorTone in ['oak', 'pine', 'stone'] &&
        cr.lampOn is bool &&
        cr.petType in ['cat', 'dog', 'both'] &&
        cr.petAffection is int && cr.petAffection >= 0 && cr.petAffection <= 100000 &&
        cr.avatarPlaced is bool &&
        isValidAvatarConfig(cr.avatarConfig) &&
        cr.furniture is list && cr.furniture.size() <= 20 &&
        (cr.furniture.size() == 0 || isValidFurnitureItem(cr.furniture[0]));
    }

    function isValidAgendaNote(an) {
      return an is map &&
        an.keys().hasOnly(['id', 'dateKey', 'text', 'done']) &&
        an.id is string && an.id.size() >= 1 && an.id.size() <= 48 &&
        an.dateKey is string && an.dateKey.size() >= 8 && an.dateKey.size() <= 16 &&
        an.text is string && an.text.size() >= 1 && an.text.size() <= 240 &&
        an.done is bool;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll([
          'uid',
          'displayName',
          'avatarEmoji',
          'coins',
          'lokmaPower',
          'discoveredIds',
          'chattedNpcIds',
          'unlockedFurnitureStyles',
          'vehicleConfig',
          'houseExterior',
          'cozyRoomState',
          'agendaNotes',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid',
          'displayName',
          'avatarEmoji',
          'coins',
          'lokmaPower',
          'discoveredIds',
          'discoveredMuseumIds',
          'completedErrandIds',
          'chattedNpcIds',
          'unlockedFurnitureStyles',
          'vehicleConfig',
          'houseExterior',
          'cozyRoomState',
          'agendaNotes',
          'tradeProfile',
          'createdAt',
          'updatedAt'
        ]) &&
        data.uid == request.auth.uid &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 40 &&
        data.avatarEmoji is string && data.avatarEmoji.size() >= 1 && data.avatarEmoji.size() <= 12 &&
        data.coins is int && data.coins >= 0 && data.coins <= 1000000 &&
        data.lokmaPower is int && data.lokmaPower >= 0 && data.lokmaPower <= 100000 &&
        data.discoveredIds is list && data.discoveredIds.size() <= 30 &&
        (data.discoveredIds.size() == 0 || (data.discoveredIds[0] is string && data.discoveredIds[0].size() >= 1 && data.discoveredIds[0].size() <= 40)) &&
        (!('discoveredMuseumIds' in data) || (
          data.discoveredMuseumIds is list &&
          data.discoveredMuseumIds.size() <= 80 &&
          (data.discoveredMuseumIds.size() == 0 || (data.discoveredMuseumIds[0] is string && data.discoveredMuseumIds[0].size() >= 1 && data.discoveredMuseumIds[0].size() <= 48))
        )) &&
        (!('completedErrandIds' in data) || (
          data.completedErrandIds is list &&
          data.completedErrandIds.size() <= 40 &&
          (data.completedErrandIds.size() == 0 || (data.completedErrandIds[0] is string && data.completedErrandIds[0].size() >= 1 && data.completedErrandIds[0].size() <= 48))
        )) &&
        data.chattedNpcIds is list && data.chattedNpcIds.size() <= 40 &&
        (data.chattedNpcIds.size() == 0 || (data.chattedNpcIds[0] is string && data.chattedNpcIds[0].size() >= 1 && data.chattedNpcIds[0].size() <= 40)) &&
        data.unlockedFurnitureStyles is list && data.unlockedFurnitureStyles.size() <= 80 &&
        (data.unlockedFurnitureStyles.size() == 0 || (data.unlockedFurnitureStyles[0] is string && data.unlockedFurnitureStyles[0].size() >= 1 && data.unlockedFurnitureStyles[0].size() <= 64)) &&
        isValidVehicleConfig(data.vehicleConfig) &&
        isValidHouseExterior(data.houseExterior) &&
        isValidCozyRoomState(data.cozyRoomState) &&
        data.agendaNotes is list && data.agendaNotes.size() <= 120 &&
        (data.agendaNotes.size() == 0 || isValidAgendaNote(data.agendaNotes[0])) &&
        (!('tradeProfile' in data) || isValidTradeProfile(data.tradeProfile)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidMarketListing(data, listingId) {
      return data.keys().hasAll([
          'id',
          'sellerUid',
          'sellerName',
          'sellerEmoji',
          'hubId',
          'itemId',
          'quantity',
          'unitPrice',
          'totalPrice',
          'feeCoins',
          'status',
          'buyerUid',
          'buyerName',
          'claimedBySeller',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id',
          'sellerUid',
          'sellerName',
          'sellerEmoji',
          'hubId',
          'itemId',
          'quantity',
          'unitPrice',
          'totalPrice',
          'feeCoins',
          'status',
          'buyerUid',
          'buyerName',
          'claimedBySeller',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.id == listingId &&
        isValidId(data.sellerUid) &&
        data.sellerName is string && data.sellerName.size() >= 1 && data.sellerName.size() <= 40 &&
        data.sellerEmoji is string && data.sellerEmoji.size() >= 1 && data.sellerEmoji.size() <= 12 &&
        isValidTradeHubId(data.hubId) &&
        isValidTradeItemId(data.itemId) &&
        data.quantity is int && data.quantity >= 1 && data.quantity <= 50 &&
        data.unitPrice is int && data.unitPrice >= 1 && data.unitPrice <= 5000 &&
        data.totalPrice is int && data.totalPrice == data.quantity * data.unitPrice &&
        data.feeCoins is int && data.feeCoins >= 0 && data.feeCoins <= data.totalPrice &&
        data.status in ['open', 'sold', 'claimed', 'cancelled'] &&
        (
          (data.status in ['open', 'cancelled'] && data.buyerUid == null && data.buyerName == null) ||
          (data.status in ['sold', 'claimed'] && isValidId(data.buyerUid) && data.buyerUid != data.sellerUid && data.buyerName is string && data.buyerName.size() >= 1 && data.buyerName.size() <= 40)
        ) &&
        data.claimedBySeller is bool &&
        (
          (data.status == 'claimed' && data.claimedBySeller == true) ||
          (data.status != 'claimed' && data.claimedBySeller == false)
        ) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidTradeLedgerEntry(data, userId, entryId) {
      return data.keys().hasAll([
          'id',
          'uid',
          'idempotencyKey',
          'type',
          'hubId',
          'itemId',
          'quantity',
          'unitPrice',
          'totalCoins',
          'feeCoins',
          'profitDelta',
          'balanceAfter',
          'counterpartyName',
          'note',
          'createdAt'
        ]) &&
        data.keys().hasOnly([
          'id',
          'uid',
          'idempotencyKey',
          'type',
          'hubId',
          'itemId',
          'quantity',
          'unitPrice',
          'totalCoins',
          'feeCoins',
          'profitDelta',
          'balanceAfter',
          'counterpartyName',
          'note',
          'createdAt'
        ]) &&
        isValidId(data.id) &&
        data.id == entryId &&
        isValidId(data.uid) &&
        data.uid == userId &&
        data.uid == request.auth.uid &&
        data.idempotencyKey is string && data.idempotencyKey.size() >= 1 && data.idempotencyKey.size() <= 64 && data.idempotencyKey.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.type in [
          'buy_hub',
          'sell_hub',
          'contract_complete',
          'listing_create',
          'listing_cancel',
          'listing_buy',
          'listing_claim',
          'tier_upgrade',
          'starter_grant'
        ] &&
        (data.hubId == null || isValidTradeHubId(data.hubId)) &&
        (data.itemId == null || isValidTradeItemId(data.itemId)) &&
        data.quantity is int && data.quantity >= 0 && data.quantity <= 999 &&
        data.unitPrice is int && data.unitPrice >= 0 && data.unitPrice <= 100000 &&
        data.totalCoins is int && data.totalCoins >= -1000000 && data.totalCoins <= 1000000 &&
        data.feeCoins is int && data.feeCoins >= 0 && data.feeCoins <= 100000 &&
        data.profitDelta is int && data.profitDelta >= -1000000 && data.profitDelta <= 1000000 &&
        data.balanceAfter is int && data.balanceAfter >= 0 && data.balanceAfter <= 1000000 &&
        data.counterpartyName is string && data.counterpartyName.size() >= 1 && data.counterpartyName.size() <= 48 &&
        data.note is string && data.note.size() >= 1 && data.note.size() <= 160 &&
        data.createdAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;

      allow create: if isVerified() &&
        isValidId(userId) &&
        isOwner(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isVerified() &&
        isValidId(userId) &&
        isOwner(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'avatarEmoji',
          'coins',
          'lokmaPower',
          'discoveredIds',
          'discoveredMuseumIds',
          'completedErrandIds',
          'chattedNpcIds',
          'unlockedFurnitureStyles',
          'vehicleConfig',
          'houseExterior',
          'cozyRoomState',
          'agendaNotes',
          'tradeProfile',
          'updatedAt'
        ]);

      allow delete: if isSignedIn() &&
        isVerified() &&
        isValidId(userId) &&
        isOwner(userId);

      // Append-only immutable trade ledger subcollection
      match /tradeLedger/{entryId} {
        allow get: if isValidId(userId) && isValidId(entryId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.uid == request.auth.uid;

        allow create: if isVerified() &&
          isValidId(userId) &&
          isValidId(entryId) &&
          isOwner(userId) &&
          isValidTradeLedgerEntry(incoming(), userId, entryId) &&
          incoming().createdAt == request.time &&
          exists(/databases/$(database)/documents/users/$(userId));

        allow update: if false;
        allow delete: if false;
      }
    }

    // Online P2P Escrow Market Listings (No PII)
    match /marketListings/{listingId} {
      allow get: if isSignedIn() &&
        isValidId(listingId) &&
        (
          existing().status == 'open' ||
          existing().sellerUid == request.auth.uid ||
          existing().buyerUid == request.auth.uid
        );

      allow list: if isSignedIn() &&
        (
          resource.data.status == 'open' ||
          resource.data.sellerUid == request.auth.uid ||
          resource.data.buyerUid == request.auth.uid
        );

      allow create: if isVerified() &&
        isValidId(listingId) &&
        isValidMarketListing(incoming(), listingId) &&
        incoming().sellerUid == request.auth.uid &&
        incoming().status == 'open' &&
        incoming().buyerUid == null &&
        incoming().buyerName == null &&
        incoming().claimedBySeller == false &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));

      allow update: if isVerified() &&
        isValidId(listingId) &&
        isValidMarketListing(incoming(), listingId) &&
        !(existing().status in ['claimed', 'cancelled']) &&
        incoming().id == existing().id &&
        incoming().sellerUid == existing().sellerUid &&
        incoming().sellerName == existing().sellerName &&
        incoming().sellerEmoji == existing().sellerEmoji &&
        incoming().hubId == existing().hubId &&
        incoming().itemId == existing().itemId &&
        incoming().quantity == existing().quantity &&
        incoming().unitPrice == existing().unitPrice &&
        incoming().totalPrice == existing().totalPrice &&
        incoming().feeCoins == existing().feeCoins &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          // Action 1: Seller cancels an open listing
          (
            isOwner(existing().sellerUid) &&
            existing().status == 'open' &&
            incoming().status == 'cancelled' &&
            incoming().buyerUid == null &&
            incoming().buyerName == null &&
            incoming().claimedBySeller == false &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          ) ||
          // Action 2: Another verified player fills (purchases) an open listing
          (
            existing().status == 'open' &&
            request.auth.uid != existing().sellerUid &&
            incoming().status == 'sold' &&
            incoming().buyerUid == request.auth.uid &&
            incoming().buyerName is string &&
            incoming().claimedBySeller == false &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'buyerUid', 'buyerName', 'updatedAt']) &&
            exists(/databases/$(database)/documents/users/$(request.auth.uid))
          ) ||
          // Action 3: Seller claims escrow proceeds once sold
          (
            isOwner(existing().sellerUid) &&
            existing().status == 'sold' &&
            existing().claimedBySeller == false &&
            incoming().status == 'claimed' &&
            incoming().claimedBySeller == true &&
            incoming().buyerUid == existing().buyerUid &&
            incoming().buyerName == existing().buyerName &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'claimedBySeller', 'updatedAt'])
          )
        );

      allow delete: if false;
    }
  }
}
